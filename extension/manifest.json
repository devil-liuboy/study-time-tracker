{
  "manifest_version": 3,
  "name": "学习时长统计系统 · 浏览器连接",
  "version": "1.0.0",
  "description": "向本机学习时长统计系统报告当前前台标签页的域名，不传输完整网址、标题或网页内容。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "学习时长统计系统",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:47831"
  }
}
